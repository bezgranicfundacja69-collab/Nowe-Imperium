rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidListing(data) {
      return data.keys().hasAll(['title', 'price', 'category', 'sellerId', 'status']) &&
             data.title is string && data.title.size() <= 300 &&
             data.price is number && data.price >= 0 &&
             data.sellerId == request.auth.uid &&
             data.status in ['active', 'sold', 'hidden'];
    }

    function isValidConversation(data) {
      return data.participants is list && 
             data.participants.size() >= 2 &&
             request.auth.uid in data.participants;
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 5000;
    }

    function isValidTransaction(data) {
      return data.userId == request.auth.uid &&
             data.amount is number &&
             data.type is string;
    }

    function isValidBot(data) {
      return data.userId == request.auth.uid &&
             data.name is string &&
             data.status in ['active', 'paused', 'error', 'idle'];
    }

    function isValidReview(data) {
      return data.reviewerId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidCreditProfile(data) {
      return data.userId == request.auth.uid &&
             data.creditLimit is number &&
             data.availableCredit is number;
    }

    function isValidLoanApplication(data) {
      return data.userId == request.auth.uid &&
             data.amount is number && data.amount > 0 &&
             data.status in ['pending', 'approved', 'rejected', 'disbursed'];
    }

    function isValidNotification(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.message is string &&
             data.type in ['listing_alert', 'system', 'message'] &&
             data.read is bool;
    }

    function isValidPreference(data) {
      return data.userId == request.auth.uid &&
             data.subscribedCategories is list;
    }

    function isValidStripeInfo(data) {
      return data.userId == request.auth.uid &&
             data.stripeAccountId is string &&
             data.stripeAccountId.size() <= 128;
    }

    // --- Collections ---
    
    match /notifications/{notifId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow get: if isSignedIn() && (existing().userId == request.auth.uid);
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isOwner(existing().userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(existing().userId);
    }

    match /userPreferences/{userId} {
      allow read, create, update: if isOwner(userId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow update: if isSignedIn() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['averageRating', 'reviewCount', 'rating', 'updatedAt'])
      );
    }

    match /nowebots/{botId} {
      allow read, update, delete: if isOwner(existing().userId);
      allow create: if isSignedIn() && isValidBot(incoming());
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidListing(incoming());
      allow update: if isSignedIn() && (
        isOwner(existing().sellerId) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['reviewCount', 'averageRating', 'updatedAt', 'lastMessage', 'status'])
      );
      allow delete: if isOwner(existing().sellerId);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidReview(incoming());
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
    }

    match /wallets/{userId} {
      allow read, create, update: if isOwner(userId);
    }

    match /conversations/{convId} {
      allow get: if isVerifiedUser() && request.auth.uid in existing().participants;
      allow list: if isVerifiedUser() && request.auth.uid in resource.data.participants;
      allow create: if isVerifiedUser() && isValidConversation(incoming());
      allow update: if isVerifiedUser() && request.auth.uid in existing().participants &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'participants']);
                      
      match /messages/{msgId} {
        allow read: if isVerifiedUser() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isVerifiedUser() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants && isValidMessage(incoming());
      }
    }

    match /transactions/{txId} {
      allow get, list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || existing().userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidTransaction(incoming());
    }

    match /creditProfiles/{userId} {
      allow read, create, update: if isOwner(userId);
    }

    match /loanApplications/{appId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && isValidLoanApplication(incoming());
      allow update: if isOwner(existing().userId) && isValidLoanApplication(incoming());
      allow delete: if isOwner(existing().userId) && existing().status == 'pending';
    }

    match /sellerStripeInfo/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
