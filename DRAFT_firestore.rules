rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    // --- Entity Validations ---

    function isValidListing(data) {
      return data.keys().hasAll(['title', 'price', 'category', 'sellerId', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string && data.category.size() <= 64 &&
             data.sellerId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidConversation(data) {
      return data.participants is list && 
             data.participants.size() >= 2 && data.participants.size() <= 10 &&
             request.auth.uid in data.participants &&
             data.lastUpdate == request.time;
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 10000 &&
             data.createdAt == request.time;
    }

    function isValidTransaction(data) {
      return data.userId == request.auth.uid &&
             data.amount is number &&
             data.type in ['deposit', 'withdrawal', 'sale', 'purchase'] &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /listings/{listingId} {
      allow read: if true; // Public marketplace
      allow create: if isVerifiedUser() && isValidListing(incoming()) && isValidId(listingId);
      allow update: if isVerifiedUser() && isOwner(existing().sellerId) && 
                      isValidListing(incoming()) &&
                      incoming().sellerId == existing().sellerId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'price', 'category', 'subcategory', 'image', 'location', 'type', 'updatedAt']);
      allow delete: if isOwner(existing().sellerId);
    }

    match /conversations/{convId} {
      allow get: if isVerifiedUser() && request.auth.uid in existing().participants && isValidId(convId);
      allow list: if isVerifiedUser() && request.auth.uid in existing().participants;
      allow create: if isVerifiedUser() && isValidConversation(incoming()) && isValidId(convId);
      allow update: if isVerifiedUser() && request.auth.uid in existing().participants &&
                      isValidConversation(incoming()) &&
                      incoming().participants == existing().participants &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastUpdate', 'listingId']);
    }

    match /conversations/{convId}/messages/{msgId} {
      // 1. The Master Gate: Verify parent conversation membership
      function isParticipant() {
        return request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }

      allow read: if isVerifiedUser() && isParticipant();
      allow create: if isVerifiedUser() && isParticipant() && isValidMessage(incoming()) && isValidId(msgId);
    }

    match /users/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerifiedUser() && incoming().reviewerId == request.auth.uid && isValidId(reviewId) && isValidId(userId);
    }

    match /transactions/{txId} {
      allow read: if isVerifiedUser() && isOwner(existing().userId) && isValidId(txId);
      allow create: if isVerifiedUser() && isValidTransaction(incoming()) && isValidId(txId);
    }
  }
}
